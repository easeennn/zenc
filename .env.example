# Public production URL (no trailing slash). Enables canonical URLs, sitemap
# absolute URLs, Open Graph metadataBase and Organization structured data.
# Leave unset until the real domain exists.
NEXT_PUBLIC_SITE_URL=

# Server-only. Where validated project inquiries are forwarded (JSON POST).
# Works with any webhook-style receiver (automation platform, serverless
# function, CRM intake URL, email-service relay). Never prefix with NEXT_PUBLIC_.
# While unset, /api/contact answers 501 and the form tells visitors honestly
# that their message was NOT sent.
CONTACT_WEBHOOK_URL=
